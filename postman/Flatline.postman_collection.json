{
  "info": {
    "_postman_id": "3fd47d06-2bb3-430f-b869-e66826730a0a",
    "name": "Flatline",
    "description": "The Flatline API on the live demo, in the order a judge would try it. Everything runs on the PayPal sandbox; no real money moves.\n\nSet baseUrl to http://localhost:8000 to use it against a local `make up`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Look around",
      "item": [
