# Copy to .env and fill in. .env is gitignored — never commit real values.
# Everything runs offline with the defaults below (MOCK + mock LLM).
# Keep comments on their own lines: Docker Compose env_file treats
# `KEY=value  # comment` as part of the value.

# --- Modes ---
# PAYPAL_ENVIRONMENT: MOCK | SANDBOX  (anything else = refuse to start)
PAYPAL_ENVIRONMENT=MOCK
# LLM_MODE: mock | live
LLM_MODE=mock
APP_BASE_URL=http://localhost:8000
# VERIFY_MINUTES: 10 in production; 1 keeps the demo loop short
VERIFY_MINUTES=1
DEMO_MODE=true

# --- PayPal sandbox ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID: from the sandbox webhook registration
PAYPAL_WEBHOOK_ID=
# PAYPAL_SANDBOX_PLAN_ID: monthly plan used by the demo shop
PAYPAL_SANDBOX_PLAN_ID=
PAYPAL_SANDBOX_PRODUCT_ID=

# --- Models (LiteLLM model strings) ---
# Pick one provider. Check it with: python scripts/llm_check.py
# Gemini (free tier works): MODEL_FAST=gemini/<model>, set GEMINI_API_KEY.
#   The Pro models are rate limited to nothing on the free tier; use Flash models.
#   python scripts/llm_check.py --list shows the models your key can use.
# Local Ollama (for example Qwen): MODEL_FAST=ollama_chat/<name from `ollama list`>
#   and OLLAMA_API_BASE=http://localhost:11434. Docker reaches it via host.docker.internal.
# Azure OpenAI: MODEL_FAST=azure/<deployment name>, set the AZURE_* values.
MODEL_FAST=gemini/gemini-2.5-flash-lite
MODEL_REASONING=gemini/gemini-2.5-flash
# Tried in order when an agent's own model fails, for example on a free tier 429.
MODEL_FALLBACKS=gemini/gemini-3.5-flash,gemini/gemini-3.1-flash-lite,gemini/gemini-2.5-flash-lite
GEMINI_API_KEY=
OLLAMA_API_BASE=
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-08-01-preview

# --- Storage ---
DATABASE_URL=postgresql+psycopg://flatline:flatline@localhost:5432/flatline

# --- Policy ---
# REFUND_APPROVAL_MAX: single refunds above this are forbidden for agents
REFUND_APPROVAL_MAX=50.00
# AUTO_REFUND_MAX: a refund at or under this runs without a click. 0 = every refund waits.
AUTO_REFUND_MAX=0
# DAILY_REFUND_BUDGET: the most the agents may refund in any 24 hours
DAILY_REFUND_BUDGET=200.00
AUTO_ACTIONS_ENABLED=true
# Recovery: after an incident is resolved, ask the lost sales back (always with approval)
RECOVERY_ENABLED=true
# RECOVERY_MAX_LINKS / RECOVERY_MAX_TOTAL: caps on one recovery proposal
RECOVERY_MAX_LINKS=25
RECOVERY_MAX_TOTAL=1000.00

# --- Dashboard ---
# DASHBOARD_PASSCODE: shared passcode for the hosted demo
DASHBOARD_PASSCODE=demo-judge
# INJECT_TOKEN: protects synthetic-event and chaos endpoints
INJECT_TOKEN=change-me

# --- Optional ---
# GITHUB_TOKEN: if set, config rollbacks also open a PR
GITHUB_TOKEN=
GITHUB_REPO=mazzyy/Flatline
# NOTIFY_WEBHOOK_URL: Slack/Telegram/ntfy webhook for alerts
NOTIFY_WEBHOOK_URL=
FLATLINE_API_URL=http://localhost:8000
SHOP_PORT=3000
# One-container hosting (Heroku): RUN_SHOP=true starts the demo shop inside the API
# container and serves it under /shop. Leave unset with docker compose.
# RUN_SHOP=true
# SHOP_PUBLIC_URL: where a browser finds the shop. Empty = same host, port 3000.
SHOP_PUBLIC_URL=
LOG_LEVEL=INFO
